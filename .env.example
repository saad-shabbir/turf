# Copy to .env locally. Configure the same two public values in GitHub's iOS build.
# Public client configuration: neither value is a database-admin credential.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
EXPO_PUBLIC_GOOGLE_PLACES_KEY=

# Non-secret, compile-time alpha diagnostic visibility. Does not bypass RLS.
EXPO_PUBLIC_ENABLE_DIAGNOSTICS=true

# No service-role/secret key, database password, Apple login, signing certificate,
# private pairing file, OpenAI API key, or actual Google Places key belongs in this file.
# A legacy Supabase anon key can fill the public-key setting only if the project
# has not issued a publishable key. Never use a service_role key as a fallback.
